        Case "01_계획서_공사.hwpx": TemplateTagList = "{{계약금액천원}}|{{계약기간}}|{{계약명}}|{{고용노동부전화번호}}|{{관할고용노동부}}|{{병원}}|{{병원전화번호}}|{{보호구방호장치}}|{{소방서}}|{{소방서전화번호}}|{{안전담당자}}|{{안전대책1}}|{{안전대책2}}|{{안전보건교육}}|{{안전점검계획}}|{{업체명}}|{{업체전화}}|{{위험요인1}}|{{위험요인2}}|{{작업절차}}|{{학교명}}"
