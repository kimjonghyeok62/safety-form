        Case "15_계약이행서약서.hwpx": TemplateTagList = "{{계약명}}|{{기관대표자직위}}|{{기관명}}|{{사업자등록번호}}|{{업체대표자}}|{{업체명}}|{{업체전화}}|{{업체주소}}|{{작성일}}"
    End Select
End Function
